                        </div>

                        <div class="bg-[#121824] border border-hltv-border px-4 py-2 rounded-lg text-center">
                            <div class="text-2xl sm:text-4xl font-mono font-extrabold text-hltv-blue">
                                ${match.isLive ? `${match.currentRoundT1} : ${match.currentRoundT2}` : `${match.t1Score} : ${match.t2Score}`}
                            </div>
                            <span class="text-[10px] text-red-500 font-bold uppercase">${match.isLive ? t('live_now') : t('finished')}</span>
                        </div>

                        <div class="text-center">
                            <div class="text-xl sm:text-3xl font-extrabold text-white">${match.team2}</div>
                            <span class="text-xs text-hltv-textMuted">World Rank #2</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4 bg-[#121824] p-3 rounded-lg border border-hltv-border">
                    <h4 class="text-xs font-bold uppercase text-hltv-textMuted mb-2"><i class="fa-solid fa-map mr-1"></i> ${t('map_results')}</h4>
                    <div class="grid grid-cols-3 gap-2 text-center text-xs font-mono">
                        <div class="bg-hltv-card p-2 rounded border border-hltv-border">
                            <div class="text-hltv-textMuted">Map 1: Dust II</div>
                            <div class="font-bold text-white mt-0.5">13 - 11 (NAVI)</div>
                        </div>
                        <div class="bg-hltv-card p-2 rounded border border-hltv-border">
                            <div class="text-hltv-textMuted">Map 2: Nuke</div>
                            <div class="font-bold text-white mt-0.5">9 - 13 (Vitality)</div>
                        </div>
                        <div class="bg-hltv-card p-2 rounded border border-hltv-blue">
                            <div class="text-hltv-blue font-bold">Map 3: Mirage</div>
                            <div class="font-bold text-white mt-0.5">${match.currentRoundT1 || 11} - ${match.currentRoundT2 || 10}</div>
                        </div>
                    </div>
                </div>

                ${match.isLive ? `
                    <div class="mb-4 bg-[#0b0e16] p-3 rounded-lg border border-red-900/50">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-red-400 flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-red-600 live-pulse"></span> ${t('live_feed')}
                            </span>
                            <button onclick="simulateNextRound(${match.id})" class="text-[11px] bg-hltv-blue text-white px-2 py-0.5 rounded font-bold hover:bg-hltv-blueHover">
                                ${t('sim_round')}
                            </button>
                        </div>
                        <div class="space-y-1 font-mono text-xs text-gray-300" id="liveKillFeedBox">
                            ${match.killFeed ? match.killFeed.map(k => `<div class="bg-hltv-card/60 px-2 py-1 rounded">${k}</div>`).join('') : '...'}
                        </div>
                    </div>
                ` : ''}

                <div>
                    <h4 class="text-xs font-bold uppercase text-hltv-textMuted mb-2">${t('player_stats_map')}</h4>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-[#121824] text-hltv-textMuted border-b border-hltv-border font-mono">
                                    <th class="py-2 px-2">${t('th_player')} (${match.team1})</th>
                                    <th class="py-2 px-2 text-center">K - D</th>
                                    <th class="py-2 px-2 text-center">ADR</th>
                                    <th class="py-2 px-2 text-right">Rating 2.0</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-hltv-border font-mono">
                                <tr>
                                    <td class="py-2 px-2 font-bold text-white">b1t</td>
                                    <td class="py-2 px-2 text-center text-green-400">22 - 12</td>
                                    <td class="py-2 px-2 text-center">94.5</td>
                                    <td class="py-2 px-2 text-right font-bold text-hltv-accent">1.45</td>
                                </tr>
                                <tr>
                                    <td class="py-2 px-2 font-bold text-white">w0nderful</td>
                                    <td class="py-2 px-2 text-center text-green-400">18 - 11</td>
                                    <td class="py-2 px-2 text-center">81.2</td>
                                    <td class="py-2 px-2 text-right font-bold text-hltv-accent">1.28</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            `;

            document.getElementById('matchModal').classList.remove('hidden');
        }

        function closeMatchModal() {
            document.getElementById('matchModal').classList.add('hidden');
        }

        function simulateNextRound(matchId) {
            const match = MATCHES.find(m => m.id === matchId);
            if (!match) return;

            if (Math.random() > 0.5) match.currentRoundT1++;
            else match.currentRoundT2++;

            const mockKills = [
                'donk 💣 planted C4 on Mirage A site',
                'b1t 🎯 noscope headshot on ZywOo',
                'm0NESY 🗡️ knife kill in Connector!',
                'ropz 💥 1v3 Clutch Defuse!'
            ];
            const randomKill = mockKills[Math.floor(Math.random() * mockKills.length)];
            
            if (!match.killFeed) match.killFeed = [];
            match.killFeed.unshift(randomKill);

            renderTopTicker();
            renderHomeMatches();
            openMatchModal(matchId);
        }

        function openPlayerModal(playerName) {
            const player = PLAYERS.find(p => p.name.toLowerCase() === playerName.toLowerCase()) || PLAYERS[0];
            const content = document.getElementById('playerModalContent');

            content.innerHTML = `
                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 border-b border-hltv-border pb-4 mb-4">
                    <img src="${player.img}" alt="${player.name}" class="w-24 h-24 sm:w-32 sm:h-32 rounded-lg object-cover border-2 border-hltv-blue shadow-lg">
                    <div class="text-center sm:text-left space-y-1">
                        <div class="flex items-center justify-center sm:justify-start space-x-2">
                            <span class="text-2xl">${player.country}</span>
                            <h2 class="text-2xl font-extrabold text-white">${player.name}</h2>
                        </div>
                        <p class="text-xs text-hltv-textMuted">${player.fullName}</p>
                        <div class="inline-block bg-[#121824] px-2.5 py-1 rounded border border-hltv-border text-xs font-semibold text-hltv-blue">
                            ${player.team} • ${player.role}
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center font-mono">
                    <div class="bg-[#121824] p-3 rounded border border-hltv-border">
                        <div class="text-[10px] text-hltv-textMuted uppercase">Rating 2.0</div>
                        <div class="text-xl font-bold text-hltv-accent mt-1">${player.rating}</div>
                    </div>
                    <div class="bg-[#121824] p-3 rounded border border-hltv-border">
                        <div class="text-[10px] text-hltv-textMuted uppercase">K/D Ratio</div>
                        <div class="text-xl font-bold text-green-400 mt-1">${player.kd}</div>
                    </div>
                    <div class="bg-[#121824] p-3 rounded border border-hltv-border">
                        <div class="text-[10px] text-hltv-textMuted uppercase">ADR</div>
                        <div class="text-xl font-bold text-white mt-1">${player.adr}</div>
                    </div>
                    <div class="bg-[#121824] p-3 rounded border border-hltv-border">
                        <div class="text-[10px] text-hltv-textMuted uppercase">KAST</div>
                        <div class="text-xl font-bold text-white mt-1">${player.kast}</div>
                    </div>
                </div>
            `;

            document.getElementById('playerModal').classList.remove('hidden');
        }

        function closePlayerModal() {
            document.getElementById('playerModal').classList.add('hidden');
        }

        function openArticleModal(articleId) {
            const article = ARTICLES.find(a => a.id === articleId) || ARTICLES[0];
            const content = document.getElementById('articleModalContent');

            const titleStr = article.title[currentLang] || article.title['en'];
            const contentStr = article.content[currentLang] || article.content['en'];

            content.innerHTML = `
                <div class="border-b border-hltv-border pb-3">
                    <h1 class="text-lg sm:text-xl font-bold text-white">${titleStr}</h1>
                    <div class="text-xs text-hltv-textMuted mt-1">Author: ${article.author} • ${article.time} ${t('min_ago')}</div>
                </div>

                <div class="text-xs sm:text-sm text-gray-200 leading-relaxed py-2">
                    ${contentStr}
                </div>

                <div class="border-t border-hltv-border pt-4 mt-4">
                    <h3 class="font-bold text-xs uppercase text-hltv-textMuted mb-3"><i class="fa-regular fa-comments mr-1"></i> ${t('comments')} (${article.comments.length})</h3>
                    
                    <div class="flex gap-2 mb-3">
                        <input type="text" id="newCommentInput" placeholder="${t('leave_comment')}" class="bg-[#121824] border border-hltv-border text-xs text-white rounded px-3 py-1.5 flex-grow focus:outline-none focus:border-hltv-blue">
                        <button onclick="addCommentToArticle(${article.id})" class="bg-hltv-blue text-white px-3 py-1.5 rounded text-xs font-bold hover:bg-hltv-blueHover">${t('send_comment')}</button>
                    </div>

                    <div id="articleCommentsList" class="space-y-2">
                        ${article.comments.map(c => `
                            <div class="bg-[#121824] p-2.5 rounded border border-hltv-border text-xs">
                                <div class="flex justify-between font-bold text-white mb-1">
                                    <span>${c.user}</span>
                                    <span class="text-[10px] text-hltv-textMuted font-normal">${c.time}</span>
                                </div>
                                <div class="text-gray-300">${c.text}</div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;

            document.getElementById('articleModal').classList.remove('hidden');
        }

        function closeArticleModal() {
            document.getElementById('articleModal').classList.add('hidden');
        }

        function addCommentToArticle(articleId) {
            const input = document.getElementById('newCommentInput');
            if (!input || !input.value.trim()) return;

            const article = ARTICLES.find(a => a.id === articleId);
            if (article) {
                article.comments.unshift({
                    user: 's1mple_fan99',
                    text: input.value.trim(),
                    time: 'Just now'
                });
                article.commentsCount = article.comments.length;
                openArticleModal(articleId);
                renderLatestNews();
            }
        }

        function openNewThreadModal() {
            document.getElementById('newThreadModal').classList.remove('hidden');
        }
        function closeNewThreadModal() {
            document.getElementById('newThreadModal').classList.add('hidden');
        }
        function submitNewThread() {
            const title = document.getElementById('newThreadTitle').value.trim();
            if (!title) return;

            FORUM_THREADS.unshift({
                title: { en: title, ru: title, uk: title },
                author: 's1mple_fan99',
                replies: 0,
                time: '0',
                flag: '🇺🇦'
            });

            closeNewThreadModal();
            renderForumTab();
        }

        function votePoll(optionIdx) {
            const val0 = document.getElementById('poll-val-0');
            const val1 = document.getElementById('poll-val-1');
            if (optionIdx === 0) {
                val0.innerText = '55%';
                val1.innerText = '45%';
            } else {
                val0.innerText = '53%';
                val1.innerText = '47%';
            }
        }

        function handleGlobalSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            if (!query) return;

            const matchedPlayer = PLAYERS.find(p => p.name.toLowerCase().includes(query));
            if (matchedPlayer && query.length >= 3) {
                openPlayerModal(matchedPlayer.name);
            }
        }

        function toggleNotifications() {
            alert('NAVI vs Vitality match is LIVE right now!');
        }

        // On Page Load Initialization
        window.onload = function() {
            changeLanguage('ru'); // Default to Russian, user can click EN / UA / RU anytime

            setInterval(() => {
                const liveMatch = MATCHES.find(m => m.isLive);
                if (liveMatch && Math.random() > 0.6) {
                    if (Math.random() > 0.5) liveMatch.currentRoundT1++;
                    else liveMatch.currentRoundT2++;
                    renderTopTicker();
                    if (currentTab === 'home') renderHomeMatches();
                }
            }, 8000);
        };
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HLTV.org - CS2 News, Matches, Rankings & Stats</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for player stats -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        hltv: {
                            bg: '#0e131d',
                            card: '#18202d',
                            cardHover: '#202a3c',
                            border: '#293548',
                            blue: '#2d6bb3',
                            blueHover: '#3b7fce',
                            accent: '#f5a623',
                            green: '#22c55e',
                            live: '#dc2626',
                            text: '#d1d5db',
                            textMuted: '#899bb3'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: #0e131d;
            color: #d1d5db;
        }
        /* HLTV signature star rating color */
        .star-filled { color: #f5a623; }
        .star-empty { color: #4b5563; }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0e131d;
        }
        ::-webkit-scrollbar-thumb {
            background: #293548;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3b7fce;
        }
        .live-pulse {
            animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(220, 38, 38, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-hltv-bg text-hltv-text text-sm select-none antialiased">

    <!-- Top Header Bar -->
    <header class="bg-[#121824] border-b border-hltv-border sticky top-0 z-40 shadow-lg">
        <div class="max-w-7xl mx-auto px-2 sm:px-4 flex items-center justify-between h-14">
            
            <!-- Logo & Main Navigation -->
            <div class="flex items-center space-x-6">
                <!-- HLTV Brand Logo -->
                <button onclick="switchTab('home')" class="flex items-center space-x-2 focus:outline-none">
                    <div class="bg-hltv-blue text-white font-extrabold text-xl px-2.5 py-1 rounded tracking-wider shadow">
                        HLTV<span class="text-xs text-hltv-accent font-normal border-l border-blue-400 pl-1.5 ml-1">CS2</span>
                    </div>
                </button>

                <!-- Navigation Tabs (Desktop) -->
                <nav class="hidden md:flex space-x-1 font-semibold text-xs uppercase tracking-wider text-hltv-textMuted">
                    <button id="nav-home" onclick="switchTab('home')" class="px-3 py-2 rounded hover:text-white hover:bg-hltv-card transition" data-i18n="nav_news">Новости</button>
                    <button id="nav-matches" onclick="switchTab('matches')" class="px-3 py-2 rounded hover:text-white hover:bg-hltv-card transition flex items-center gap-1.5">
                        <span data-i18n="nav_matches">Матчи</span> <span class="bg-hltv-live text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold">3 LIVE</span>
                    </button>
                    <button id="nav-rankings" onclick="switchTab('rankings')" class="px-3 py-2 rounded hover:text-white hover:bg-hltv-card transition" data-i18n="nav_rankings">Рейтинг</button>
                    <button id="nav-stats" onclick="switchTab('stats')" class="px-3 py-2 rounded hover:text-white hover:bg-hltv-card transition" data-i18n="nav_stats">Статистика</button>
                    <button id="nav-events" onclick="switchTab('events')" class="px-3 py-2 rounded hover:text-white hover:bg-hltv-card transition" data-i18n="nav_events">Турниры</button>
                    <button id="nav-forum" onclick="switchTab('forum')" class="px-3 py-2 rounded hover:text-white hover:bg-hltv-card transition" data-i18n="nav_forum">Форум</button>
                </nav>
            </div>

            <!-- Header Right Controls -->
            <div class="flex items-center space-x-3">
                <!-- Language Switcher Selector -->
                <div class="flex items-center bg-[#0b0e16] p-1 rounded-lg border border-hltv-border font-mono text-xs">
                    <button onclick="changeLanguage('en')" id="lang-btn-en" class="px-2 py-0.5 rounded font-bold transition hover:text-white">EN</button>
                    <button onclick="changeLanguage('uk')" id="lang-btn-uk" class="px-2 py-0.5 rounded font-bold transition hover:text-white">UA</button>
                    <button onclick="changeLanguage('ru')" id="lang-btn-ru" class="px-2 py-0.5 rounded font-bold transition hover:text-white">RU</button>
                </div>

                <!-- Search Box -->
                <div class="relative hidden lg:block">
                    <input type="text" id="searchInput" onkeyup="handleGlobalSearch()" placeholder="Поиск игрока, команды..." 
                           class="bg-[#0b0e16] text-xs text-white border border-hltv-border rounded-full py-1.5 pl-8 pr-4 w-40 xl:w-52 focus:outline-none focus:border-hltv-blue transition">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-hltv-textMuted text-xs"></i>
                </div>

                <!-- Notifications Simulator -->
                <button onclick="toggleNotifications()" class="relative p-2 rounded-full hover:bg-hltv-card text-hltv-textMuted hover:text-white transition">
                    <i class="fa-regular fa-bell text-base"></i>
                    <span class="absolute top-1 right-1 w-2 h-2 bg-hltv-blue rounded-full"></span>
                </button>

                <!-- Profile Mock -->
                <div class="flex items-center space-x-2 border-l border-hltv-border pl-3">
                    <img src="https://images.unsplash.com/photo-1566492031773-4f4e44671857?w=100&auto=format&fit=crop&q=80" alt="Avatar" class="w-7 h-7 rounded-full border border-hltv-blue object-cover">
                    <span class="hidden xl:inline text-xs font-semibold text-white">s1mple_fan99</span>
                </div>

                <!-- Mobile Menu Button -->
                <button onclick="toggleMobileNav()" class="md:hidden p-2 text-hltv-textMuted hover:text-white">
                    <i class="fa-solid fa-bars text-lg"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Drawer -->
        <div id="mobileNav" class="hidden md:hidden bg-[#121824] border-t border-hltv-border px-4 py-3 space-y-2">
            <button onclick="switchTab('home'); toggleMobileNav()" class="block w-full text-left py-2 font-semibold" data-i18n="nav_news">Новости</button>
            <button onclick="switchTab('matches'); toggleMobileNav()" class="block w-full text-left py-2 font-semibold text-red-400"><span data-i18n="nav_matches">Матчи</span> (3 LIVE)</button>
            <button onclick="switchTab('rankings'); toggleMobileNav()" class="block w-full text-left py-2 font-semibold" data-i18n="nav_rankings">Рейтинг</button>
            <button onclick="switchTab('stats'); toggleMobileNav()" class="block w-full text-left py-2 font-semibold" data-i18n="nav_stats">Статистика</button>
            <button onclick="switchTab('events'); toggleMobileNav()" class="block w-full text-left py-2 font-semibold" data-i18n="nav_events">Турниры</button>
            <button onclick="switchTab('forum'); toggleMobileNav()" class="block w-full text-left py-2 font-semibold" data-i18n="nav_forum">Форум</button>
        </div>
    </header>

    <!-- Top Live Ticker Ribbon -->
    <div class="bg-[#121620] border-b border-hltv-border overflow-x-auto py-2 px-3 text-xs whitespace-nowrap scrollbar-thin">
        <div class="max-w-7xl mx-auto flex items-center space-x-3">
            <span class="text-xs font-bold text-hltv-accent uppercase tracking-wider flex items-center gap-1">
                <i class="fa-solid fa-bolt text-yellow-500"></i> <span data-i18n="score_label">Счёт:</span>
            </span>

            <!-- Ticker Match Items -->
            <div id="topTickerContainer" class="flex items-center space-x-3">
                <!-- Dynamically populated via JS -->
            </div>
        </div>
    </div>

    <!-- Main Content Layout Container -->
    <main class="max-w-7xl mx-auto px-2 sm:px-4 py-4 flex-grow w-full">

        <!-- TAB 1: HOME PAGE -->
        <div id="tab-home" class="tab-content grid grid-cols-1 lg:grid-cols-12 gap-4">
            
            <!-- Left Main Column (News & Featured Matches) - 8 Cols -->
            <div class="lg:col-span-8 space-y-4">

                <!-- Featured Major Headline Banner -->
                <div id="heroNewsBanner" class="relative rounded-lg overflow-hidden border border-hltv-border bg-hltv-card group cursor-pointer" onclick="openArticleModal(0)">
                    <!-- Content rendered dynamically via JS -->
                </div>

                <!-- Match Stars Quick Filters -->
                <div class="bg-hltv-card p-3 rounded-lg border border-hltv-border flex items-center justify-between flex-wrap gap-2">
                    <div class="flex items-center space-x-2">
                        <span class="font-bold text-xs uppercase text-hltv-textMuted" data-i18n="matches_day">Матчи дня:</span>
                        <div class="flex space-x-1" id="starFilterButtons">
                            <button onclick="filterMatchesByStars(0)" class="px-2 py-1 text-xs rounded bg-hltv-blue text-white font-medium" data-i18n="filter_all">Все</button>
                            <button onclick="filterMatchesByStars(3)" class="px-2 py-1 text-xs rounded bg-[#0b0e16] hover:bg-hltv-border text-yellow-400 font-medium">3+ ★</button>
                            <button onclick="filterMatchesByStars(5)" class="px-2 py-1 text-xs rounded bg-[#0b0e16] hover:bg-hltv-border text-yellow-400 font-medium">5 ★ Top</button>
                        </div>
                    </div>
                    <span class="text-xs text-hltv-textMuted" id="matchCounterText">Показано 6 матчей</span>
                </div>

                <!-- Today's Match List Box -->
                <div class="bg-hltv-card rounded-lg border border-hltv-border overflow-hidden">
                    <div class="bg-[#121824] px-4 py-2.5 border-b border-hltv-border font-bold text-xs uppercase text-hltv-textMuted flex justify-between items-center">
                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-gamepad text-hltv-blue"></i> <span data-i18n="main_matches_title">Главные встречи</span></span>
                        <span class="text-[11px] text-gray-400 font-normal" data-i18n="time_zone">Время: MSK (UTC+3)</span>
                    </div>

                    <div id="homeMatchesContainer" class="divide-y divide-hltv-border">
                        <!-- Populated dynamically via JS -->
                    </div>
                </div>

                <!-- Latest CS2 News List Section -->
                <div class="bg-hltv-card rounded-lg border border-hltv-border p-4">
                    <div class="flex items-center justify-between mb-4 border-b border-hltv-border pb-2">
                        <h2 class="font-bold text-base text-white flex items-center gap-2">
                            <i class="fa-solid fa-newspaper text-hltv-blue"></i> <span data-i18n="latest_news">Последние новости CS2</span>
                        </h2>
                        <button onclick="switchTab('home')" class="text-xs text-hltv-blue hover:underline"><span data-i18n="all_news">Все новости</span> &rarr;</button>
                    </div>

                    <div id="latestNewsContainer" class="space-y-3">
                        <!-- News items JS -->
                    </div>
                </div>

            </div>

            <!-- Right Sidebar Column (Rankings, Tournaments, Polls) - 4 Cols -->
            <div class="lg:col-span-4 space-y-4">

                <!-- Top 10 World Ranking Widget -->
                <div class="bg-hltv-card rounded-lg border border-hltv-border p-3">
                    <div class="flex items-center justify-between pb-2 mb-2 border-b border-hltv-border">
                        <span class="font-bold text-xs uppercase text-white flex items-center gap-1.5">
                            <i class="fa-solid fa-trophy text-yellow-500"></i> <span data-i18n="hltv_rank_title">Рейтинг HLTV (Топ 10)</span>
                        </span>
                        <span class="text-[10px] text-hltv-textMuted"><span data-i18n="updated">Обновлено</span>: 23 Mar</span>
                    </div>

                    <div id="sidebarRankingContainer" class="space-y-1.5">
                        <!-- Dynamically filled with top 10 teams -->
                    </div>

                    <button onclick="switchTab('rankings')" class="w-full mt-3 py-1.5 text-xs text-center font-bold bg-[#121824] hover:bg-hltv-border text-hltv-blue rounded transition">
                        <span data-i18n="full_ranking">Полный рейтинг Top 30</span> &rarr;
                    </button>
                </div>

                <!-- Live / Ongoing Tournaments Widget -->
                <div class="bg-hltv-card rounded-lg border border-hltv-border p-3">
                    <div class="flex items-center justify-between pb-2 mb-2 border-b border-hltv-border">
                        <span class="font-bold text-xs uppercase text-white flex items-center gap-1.5">
                            <i class="fa-solid fa-calendar-days text-hltv-blue"></i> <span data-i18n="ongoing_events">Текущие турниры</span>
                        </span>
                    </div>
                    <div class="space-y-2" id="sidebarEventsList">
                        <!-- Rendered by JS -->
                    </div>
                </div>

                <!-- Community Poll Widget -->
                <div class="bg-hltv-card rounded-lg border border-hltv-border p-3">
                    <div class="flex items-center justify-between pb-2 mb-2 border-b border-hltv-border">
                        <span class="font-bold text-xs uppercase text-white flex items-center gap-1.5">
                            <i class="fa-solid fa-check-to-slot text-green-400"></i> <span data-i18n="poll_of_day">Опрос дня</span>
                        </span>
                    </div>
                    <p class="text-xs text-white font-medium mb-3" data-i18n="poll_question">Кто победит в Гранд-Финале IEM Chengdu 2026?</p>
                    
                    <div id="pollOptionsContainer" class="space-y-2">
                        <button onclick="votePoll(0)" class="w-full text-left p-2 rounded bg-[#121824] hover:bg-hltv-blue/20 border border-hltv-border hover:border-hltv-blue transition text-xs flex justify-between items-center group">
                            <span class="font-bold group-hover:text-white">Natus Vincere</span>
                            <span class="text-hltv-textMuted font-mono text-[11px]" id="poll-val-0">54%</span>
                        </button>
                        <button onclick="votePoll(1)" class="w-full text-left p-2 rounded bg-[#121824] hover:bg-hltv-blue/20 border border-hltv-border hover:border-hltv-blue transition text-xs flex justify-between items-center group">
                            <span class="font-bold group-hover:text-white">Team Vitality</span>
                            <span class="text-hltv-textMuted font-mono text-[11px]" id="poll-val-1">46%</span>
                        </button>
                    </div>
                    <div class="text-[10px] text-hltv-textMuted mt-2 text-right"><span data-i18n="total_votes">Всего голосов:</span> 18,420</div>
                </div>

                <!-- Forum Latest Discussions Mini Widget -->
                <div class="bg-hltv-card rounded-lg border border-hltv-border p-3">
                    <div class="flex items-center justify-between pb-2 mb-2 border-b border-hltv-border">
                        <span class="font-bold text-xs uppercase text-white flex items-center gap-1.5">
                            <i class="fa-solid fa-comments text-hltv-blue"></i> <span data-i18n="forum_active">Активно на Форуме</span>
                        </span>
                        <button onclick="switchTab('forum')" class="text-[11px] text-hltv-blue" data-i18n="go_to_forum">Перейти</button>
                    </div>
                    <div id="sidebarForumThreads" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>

            </div>
        </div>

        <!-- TAB 2: FULL MATCHES & RESULTS -->
        <div id="tab-matches" class="tab-content hidden space-y-4">
            <div class="bg-hltv-card p-4 rounded-lg border border-hltv-border flex flex-col md:flex-row justify-between items-center gap-4">
                <div>
                    <h1 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-crosshairs text-hltv-blue"></i> <span data-i18n="matches_title">Матчи & Результаты CS2</span>
                    </h1>
                    <p class="text-xs text-hltv-textMuted" data-i18n="matches_subtitle">Все запланированные встречи, онлайн трансляции и архив результатов</p>
                </div>

                <!-- Filter Sub-tabs -->
                <div class="flex items-center space-x-1 bg-[#121824] p-1 rounded-lg border border-hltv-border">
                    <button onclick="switchMatchSubtab('all')" id="subtab-match-all" class="px-3 py-1.5 text-xs font-bold rounded bg-hltv-blue text-white" data-i18n="all_matches">Все матчи</button>
                    <button onclick="switchMatchSubtab('live')" id="subtab-match-live" class="px-3 py-1.5 text-xs font-bold rounded text-hltv-textMuted hover:text-white">
                        Live <span class="bg-red-600 text-white text-[10px] px-1.5 rounded-full ml-1">3</span>
                    </button>
                    <button onclick="switchMatchSubtab('results')" id="subtab-match-results" class="px-3 py-1.5 text-xs font-bold rounded text-hltv-textMuted hover:text-white" data-i18n="finished">Результаты</button>
                </div>
            </div>

            <!-- Matches Main Grid Container -->
            <div id="matchesTabContent" class="bg-hltv-card rounded-lg border border-hltv-border divide-y divide-hltv-border">
                <!-- Dynamically filled in JS -->
            </div>
        </div>

        <!-- TAB 3: TEAM RANKINGS -->
        <div id="tab-rankings" class="tab-content hidden space-y-4">
            <div class="bg-hltv-card p-4 rounded-lg border border-hltv-border">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <div>
                        <h1 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-ranking-star text-yellow-500"></i> <span data-i18n="rankings_title">Мировой Рейтинг Команд HLTV</span>
                        </h1>
                        <p class="text-xs text-hltv-textMuted" data-i18n="rankings_subtitle">Обновляется каждый понедельник на основе результатов за последние 12 месяцев</p>
                    </div>
                    <div class="text-xs font-mono bg-[#121824] px-3 py-1.5 rounded border border-hltv-border text-hltv-accent" data-i18n="current_period">
                        Текущий период: Мартовский зачёт 2026
                    </div>
                </div>
            </div>

            <!-- Full Ranking Table List -->
            <div id="fullRankingsList" class="space-y-2">
                <!-- Dynamically rendered top 30 JS -->
            </div>
        </div>

        <!-- TAB 4: PLAYER STATS -->
        <div id="tab-stats" class="tab-content hidden space-y-4">
            <div class="bg-hltv-card p-4 rounded-lg border border-hltv-border flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h1 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-line text-hltv-blue"></i> <span data-i18n="stats_title">База Статистики Игроков CS2</span>
                    </h1>
                    <p class="text-xs text-hltv-textMuted" data-i18n="stats_subtitle">Лидеры по Rating 2.0 / 3.0, K/D, Headshot % и снайперским убийствам</p>
                </div>
                <div class="flex gap-2">
                    <select id="statsFilterTime" onchange="renderStatsTable()" class="bg-[#121824] border border-hltv-border rounded text-xs px-3 py-1.5 text-white">
                        <option value="2026" data-i18n="time_2026">За 2026 год (LAN)</option>
                        <option value="major" data-i18n="time_major">Только Мажоры</option>
                        <option value="alltime" data-i18n="time_alltime">За всё время</option>
                    </select>
                </div>
            </div>

            <!-- Players Leaderboard Grid -->
            <div class="bg-hltv-card rounded-lg border border-hltv-border overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-[#121824] border-b border-hltv-border text-hltv-textMuted text-[11px] uppercase font-bold">
                            <th class="py-3 px-4" data-i18n="th_player">Игрок</th>
                            <th class="py-3 px-3" data-i18n="th_team">Команда</th>
                            <th class="py-3 px-3 text-center" data-i18n="th_maps">Карты</th>
                            <th class="py-3 px-3 text-center" data-i18n="th_kddiff">K/D Diff</th>
                            <th class="py-3 px-3 text-center" data-i18n="th_kd">KD</th>
                            <th class="py-3 px-3 text-center" data-i18n="th_adr">ADR</th>
                            <th class="py-3 px-3 text-center" data-i18n="th_kast">KAST</th>
                            <th class="py-3 px-3 text-right" data-i18n="th_rating">Rating 2.0</th>
                        </tr>
                    </thead>
                    <tbody id="statsLeaderboardBody" class="divide-y divide-hltv-border text-xs font-medium">
                        <!-- Populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 5: EVENTS -->
        <div id="tab-events" class="tab-content hidden space-y-4">
            <div class="bg-hltv-card p-4 rounded-lg border border-hltv-border">
                <h1 class="text-xl font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-hltv-accent"></i> <span data-i18n="events_title">Турниры & Киберспортивные Ивенты 2026</span>
                </h1>
                <p class="text-xs text-hltv-textMuted" data-i18n="events_subtitle">Главные LAN-турниры сезона CS2</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="eventsGridContainer">
                <!-- Dynamically filled with tournament cards -->
            </div>
        </div>

        <!-- TAB 6: COMMUNITY FORUM -->
        <div id="tab-forum" class="tab-content hidden space-y-4">
            <div class="bg-hltv-card p-4 rounded-lg border border-hltv-border flex justify-between items-center">
                <div>
                    <h1 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-comments text-hltv-blue"></i> <span data-i18n="forum_title">HLTV Форум & Сообщество</span>
                    </h1>
                    <p class="text-xs text-hltv-textMuted" data-i18n="forum_subtitle">Горячие дискуссии, обсуждение ростеров и киберспортивные мемы</p>
                </div>
                <button onclick="openNewThreadModal()" class="px-3 py-2 bg-hltv-blue hover:bg-hltv-blueHover text-white rounded text-xs font-bold transition flex items-center gap-1.5">
                    <i class="fa-solid fa-plus"></i> <span data-i18n="create_thread">Создать тему</span>
                </button>
            </div>

            <!-- Forum Threads Table -->
            <div class="bg-hltv-card rounded-lg border border-hltv-border overflow-hidden">
